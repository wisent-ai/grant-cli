{
  "schema_version": 1,
  "product": "grant-cli",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "quality": [],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "stage": {
        "bin/grant-cli": "bin/grant-cli",
        "evidence/build.jsonl": "evidence/build.jsonl",
        "evidence/DIGESTS": "evidence/DIGESTS"
      },
      "runner_platform": "darwin-arm64"
    },
    "linux-amd64": {
      "quality": [],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "stage": {
        "bin/grant-cli": "bin/grant-cli",
        "evidence/build.jsonl": "evidence/build.jsonl",
        "evidence/DIGESTS": "evidence/DIGESTS"
      },
      "runner_platform": "linux-amd64"
    }
  },
  "promotion": {
    "channels": [
      "candidate"
    ],
    "reconcile": false
  }
}
